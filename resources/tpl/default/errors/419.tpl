[meta-title]{error_title} — {site.name}[/meta-title]
[meta-description]{error_message}[/meta-description]
[meta-robots]noindex, nofollow[/meta-robots]

<main class="error-page">
    <div class="error-page__card">
        <div class="error-page__code">{error_code}</div>
        <h1 class="error-page__title">{error_title}</h1>
        <p class="error-page__text">{error_message}</p>
        <div class="error-page__actions">
            <a class="error-page__btn error-page__btn--primary" href="/">Обновить и на главную</a>
        </div>
    </div>
</main>
