<article class="actor_full">
    <div class="actor_full__left">
        <div class="actor_full__image">
            {photo-list}
        </div>
    </div>
    <div class="actor_full__right">
        <h2 class="actor_full__name">{name}</h2>
        [fullname]
        <div class="actor_full__label">{fullname}</div>[/fullname]

        <div class="actor_full__list">
            [age]
            <div class="item">
                <span>Возраст:</span>
                <span>{age}</span>
            </div>
            [/age] [gender]
            <div class="item">
                <span>Пол:</span>
                <span>{gender}</span>
            </div>
            [/gender] [growth]
            <div class="item">
                <span>Рост:</span>
                <span>{growth}</span>
            </div>
            [/growth] [profession]
            <div class="item">
                <span>Специальность:</span>
                <span>{profession}</span>
            </div>
            [/profession] [hasawards]
            <div class="item">
                <span>Кол-во наград:</span>
                <span>{hasawards}</span>
            </div>
            [/hasawards] [birthday]
            <div class="item">
                <span>Дата рождения:</span>
                <span>{birthday}</span>
            </div>
            [/birthday] [zodiac]
            <div class="item">
                <span>Знак зодиака:</span>
                <span>{zodiac}</span>
            </div>
            [/zodiac] [birthplace]
            <div class="item">
                <span>Место рождения:</span>
                <span>{birthplace}</span>
            </div>
            [/birthplace] [deathday]
            <div class="item">
                <span>Дата смерти:</span>
                <span>{deathday}</span>
            </div>
            [/deathday] [deathplace]
            <div class="item">
                <span>Место смерти:</span>
                <span>{deathplace}</span>
            </div>
            [/deathplace] [facts]
            <div class="item">
                <span>Факты:</span>
                <span>{facts}</span>
            </div>
            [/facts]
        </div>

        [actor_rating]
        <div class="actor_full__rating">
            <h3>Оценить актера</h3>
            {actor_rating}
        </div>
        [/actor_rating]
    </div>
    [seo_descr]
    <div class="actor_full__text">
        {seo_descr}
    </div>
    [/seo_descr]
</article>


<h1 class="h1_title">Фильмы с {name}:</h1>