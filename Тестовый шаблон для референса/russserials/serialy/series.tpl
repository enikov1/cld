<tr[active] class="active" [/active]>
    <td>
        <div class="season-episode-card__title">
            {episode} серия
        </div>
    </td>
    <td>
        <div class="season-episode-card__date [series-past]past[/series-past][series-future]future[/series-future]">
            {episode-date}
        </div>
    </td>
    <td>
        <div class="episode__rating-stars serialy-rating-block">
            {series-rating}
        </div>
    </td>
    <td>
        [not-active]<a href="{full-link}" class="season-episode-card__link">Смотреть</a>[/not-active]</td>
    </tr>