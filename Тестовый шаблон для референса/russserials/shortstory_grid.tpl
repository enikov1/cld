<div class="short-grid with-mask">
		<div class="short-img">
			[xfgiven_poster]<img data-src="[xfvalue_poster]" alt="">[/xfgiven_poster]
			[xfnotgiven_poster]<img data-src="[xfvalue_thumb_url_poster2]" alt="">[/xfnotgiven_poster]
			<a href="{full-link}" class="mask flex-col ps-link">
				<span class="fa fa-play"></span>
			</a>

			[xfgiven_last_epizode]
			[catlist=40]<div class="badge_tr">[xfvalue_last_epizode] выпуск</div>[/catlist]
			[not-catlist=40]<div class="badge_tr">[xfvalue_last_epizode] серия</div>[/not-catlist]
			[/xfgiven_last_epizode]
		</div>
		<div class="short-bottom">
			{rating}
			<div class="button ps-link" data-href="{full-link}"></div>
		</div>
	</div>
