<div class="actor_short">
	<div class="actor_short__image">
		<img data-src="{poster}" alt="{name}">
	</div>
	<div class="actor_short__info">
		<div class="item">
			<span>Имя:</span>
			<span><a href="{link}">{name}</a></span>
		</div>
		<div class="item">
            <span>Дата рождения:</span>
            <span>{birthday}</span>
        </div>
		<div class="item">
            <span>Место рождения:</span>
            <span>{birthplace}</span>
        </div>
		<div class="item">
            <span>Пол:</span>
            <span>{gender}</span>
        </div>
		<div class="item">
            <span>Возраст:</span>
            <span>{age}</span>
        </div>
		<div class="item">
            <span>Рост:</span>
            <span>{growth}</span>
        </div>
		<div class="item">
            <span>Профессия:</span>
            <span>{profession}</span>
        </div>
		<div class="item">
            <span>Количество сцен:</span>
            <span>{count_film}</span>
        </div>
	</div>
</div>