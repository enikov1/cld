		[xfgiven_poster]<img data-src="[xfvalue_poster]" alt="{title}">[/xfgiven_poster]
		[xfnotgiven_poster]<img data-src="[xfvalue_thumb_url_poster2]" alt="{title}">[/xfnotgiven_poster]

		[xfgiven_last_epizode]
